@model List<Chat.Web.Models.AuditLogViewModel>
@{
    ViewData["Title"] = "Audit Logs";
    var jwtToken = Context.Session.GetString("JwtToken") ?? "";
}

<h3 class="mb-3">📋 Audit Logs <small class="text-success fs-6">● live</small></h3>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>#</th>
                <th>User</th>
                <th>Action</th>
                <th>Details</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody id="auditBody">
            @foreach (var log in Model)
            {
                <tr>
                    <td>@log.Id</td>
                    <td>@log.UserName</td>
                    <td>
                        <span class="badge @GetBadgeClass(log.Action)">@log.Action</span>
                    </td>
                    <td>@log.Details</td>
                    <td>@log.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">No audit logs yet.</div>
}

@functions {
    string GetBadgeClass(string action) => action switch
    {
        "Login" => "bg-success",
        "Register" => "bg-primary",
        "Logout" => "bg-secondary",
        "CreateRoom" => "bg-info",
        "DeleteRoom" => "bg-danger",
        "JoinRoom" => "bg-warning text-dark",
        "LeaveRoom" => "bg-warning text-dark",
        "PublicMessage" => "bg-primary",
        "PrivateMessage" => "bg-info",
        "UserConnected" => "bg-success",
        "UserDisconnected" => "bg-secondary",
        _ => "bg-dark"
    };
}

@section Scripts {
<script>
    const token = "@jwtToken";

    function badgeClass(action) {
        switch (action) {
            case "Login": return "bg-success";
            case "Register": return "bg-primary";
            case "Logout": return "bg-secondary";
            case "CreateRoom": return "bg-info";
            case "DeleteRoom": return "bg-danger";
            case "JoinRoom":
            case "LeaveRoom": return "bg-warning text-dark";
            case "PublicMessage": return "bg-primary";
            case "PrivateMessage": return "bg-info";
            case "UserConnected": return "bg-success";
            case "UserDisconnected": return "bg-secondary";
            default: return "bg-dark";
        }
    }

    function escapeHtml(s) {
        const div = document.createElement("div");
        div.textContent = s ?? "";
        return div.innerHTML;
    }

    const connection = new signalR.HubConnectionBuilder()
        .withUrl("https://localhost:7000/hubs/chat", { accessTokenFactory: () => token })
        .withAutomaticReconnect()
        .build();

    connection.on("AuditUpdated", function (log) {
        const body = document.getElementById("auditBody");
        const row = document.createElement("tr");
        row.innerHTML = `
            <td>${log.id}</td>
            <td>${escapeHtml(log.userName)}</td>
            <td><span class="badge ${badgeClass(log.action)}">${escapeHtml(log.action)}</span></td>
            <td>${escapeHtml(log.details)}</td>
            <td>${new Date(log.timestamp).toLocaleString()}</td>
        `;
        body.prepend(row);
    });

    connection.start().catch(err => console.error(err));
</script>
}
