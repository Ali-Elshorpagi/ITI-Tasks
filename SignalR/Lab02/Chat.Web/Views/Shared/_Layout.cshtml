<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChatApp</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <style>
        body { background-color: #f8f9fa; }
        .navbar-brand { font-weight: bold; color: #0d6efd !important; }
        .chat-box { height: 400px; overflow-y: auto; border: 1px solid #dee2e6; border-radius: 8px; padding: 15px; background: white; }
        .message-bubble { margin-bottom: 10px; }
        .message-bubble .sender { font-weight: bold; font-size: 0.85rem; color: #6c757d; }
        .message-mine { text-align: right; }
        .message-mine .bubble { background-color: #0d6efd; color: white; display: inline-block; padding: 6px 12px; border-radius: 15px 15px 0 15px; }
        .message-other .bubble { background-color: #e9ecef; display: inline-block; padding: 6px 12px; border-radius: 15px 15px 15px 0; }
        .online-dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
        .online-dot.online { background-color: #28a745; }
        .online-dot.offline { background-color: #6c757d; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">💬 ChatApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navMenu">
                <ul class="navbar-nav me-auto">
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("JwtToken")))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Rooms" asp-action="Index">Rooms</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Users" asp-action="Online">Users</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Audit" asp-action="Logs">Audit Logs</a>
                        </li>
                    }
                </ul>
                <ul class="navbar-nav">
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("JwtToken")))
                    {
                        <li class="nav-item">
                            <span class="nav-link text-white-50">👤 @Context.Session.GetString("DisplayName")</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Logout">Logout</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container">
        <main>
            @RenderBody()
        </main>
    </div>

    <footer class="text-center text-muted mt-5 py-3 border-top">
        <small>ChatApp &copy; 2026 — SignalR Lab02</small>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
